# ---------------------------------------------------------------------------
# Open MT2 server configuration
#
# Copy to `.env` for development (`npm run dev:auth` / `npm run dev:game`) or to
# `/etc/open-mt2/env` for a systemd install on Armbian/Pine A64.
# Every variable below is read by the servers — see src/core/infra/config.
# ---------------------------------------------------------------------------

# --- auth server -------------------------------------------------------------
AUTH_SERVER_PORT=11002
# Bind address of the listener. Keep 127.0.0.1 when the servers run together
# with a reverse proxy; use 0.0.0.0 only when the Metin2 client connects
# directly to this host.
AUTH_SERVER_ADDRESS=127.0.0.1

# --- game server -------------------------------------------------------------
GAME_SERVER_PORT=13001
GAME_SERVER_ADDRESS=127.0.0.1
# Address advertised to the client when it asks the auth server where to
# connect. This is the value the *client* uses, so it must be reachable from
# the player's machine (a LAN IP, a public IP, or a DNS name).
REAL_SERVER_ADDRESS=127.0.0.1

# --- logging -----------------------------------------------------------------
# error | warn | info | http | verbose | debug | silly
LOG_LEVEL=debug

# --- mysql -------------------------------------------------------------------
# On ARM64 use `mariadb` (packaged as `mariadb-server` on Armbian) or
# `mysql:8.0` in Docker. The stock `mysql:5.7` image has no arm64 build.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_ROOT_PASSWORD=123456
AUTH_DB_DATABASE_NAME=auth
GAME_DB_DATABASE_NAME=game

# Password of the `admin` / `admin1` accounts seeded by the bootstrap script.
# Change it before exposing the server to the internet.
SEED_ADMIN_PASSWORD=admin

# --- redis -------------------------------------------------------------------
CACHE_HOST=127.0.0.1
CACHE_PORT=6379
# Keepalive interval in milliseconds for the Redis client.
CACHE_PING_INTERVAL=10000

# --- runtime data ------------------------------------------------------------
# Optional. Directory holding the map attribute files, the per-map spawn
# definitions and the quest scripts, when they are NOT next to the compiled
# code (default: auto-detected from the location of the running code, so this
# can stay unset for the standard /opt/open-mt2 layout).
# OPEN_MT2_DATA_DIR=/opt/open-mt2/data